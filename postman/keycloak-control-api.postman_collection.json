      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('404',()=>pm.response.to.have.status(404));",
              "pm.test('missing execution',()=>pm.expect(pm.response.json().error.code).to.eql('execution_not_found'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Observability Invalid Limit",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/platform/v1/keycloak/observability/events?limit=501",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "platform",
            "v1",
            "keycloak",
            "observability",
            "events"
          ],
          "query": [
            {
              "key": "limit",
              "value": "501"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400',()=>pm.response.to.have.status(400));",
              "pm.test('invalid query',()=>pm.expect(pm.response.json().error.code).to.eql('invalid_query'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Compile Read Only",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/platform/v1/keycloak/compile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "platform",
            "v1",
            "keycloak",
            "compile"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));",
              "pm.test('compiled without drift',()=>{const b=pm.response.json();pm.expect(b.compiled).to.eql(true);pm.expect(b.generatedDrift).to.eql(false);});",
              "pm.test('no secret material',()=>pm.expect(pm.response.text()).to.not.match(/\"(secret|clientSecret|password)\":\"[^\"]+\"/));"
            ]
          }
        }
      ]
    },
    {
      "name": "Drift Backend Unavailable",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/platform/v1/keycloak/drift",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "platform",
            "v1",
            "keycloak",
            "drift"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('503 without admin backend',()=>pm.response.to.have.status(503));",
              "pm.test('backend code',()=>pm.expect(pm.response.json().error.code).to.eql('admin_not_configured'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Rollback Fail Closed",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"executionId\":\"missing\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/platform/v1/keycloak/reconcile/rollback",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "platform",
            "v1",
            "keycloak",
            "reconcile",
            "rollback"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('403',()=>pm.response.to.have.status(403));",
              "pm.test('disabled before evidence lookup',()=>pm.expect(pm.response.json().error.code).to.eql('apply_disabled'));"
            ]
          }
        }
      ]
    },
