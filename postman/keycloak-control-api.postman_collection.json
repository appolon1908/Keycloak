    },
    {
      "name": "Promotion Plan Blocks Missing Mapping",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"promotionId\":\"postman-blocked-plan\",\"sourceAuthorityGroup\":\"postman-missing-group\",\"targetEnvironment\":\"staging\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/platform/v1/keycloak/promotion/plan",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "platform",
            "v1",
            "keycloak",
            "promotion",
            "plan"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));",
              "pm.test('blocked',()=>{const p=pm.response.json().promotion;pm.expect(p.promotionStatus).to.eql('BLOCK');pm.expect(p.blockers).to.include('explicit_target_mapping_required');pm.expect(p.blockers).to.include('source_authority_group_not_found');pm.expect(p.packetSha256).to.match(/^[0-9a-f]{64}$/);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Promotion Plan TEST_SYN Production Forbidden",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"promotionId\":\"postman-test-syn-production\",\"sourceAuthorityGroup\":\"TEST_SYN\",\"targetEnvironment\":\"production\",\"targetIssuer\":\"https://auth.codestra.co/realms/codestra\",\"targetMapping\":{\"test-syn-postman\":\"postman\"}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/platform/v1/keycloak/promotion/plan",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "platform",
            "v1",
            "keycloak",
            "promotion",
            "plan"
          ]
        }
      },
