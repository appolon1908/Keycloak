        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));",
              "pm.test('TEST_SYN never promotes to production',()=>{const p=pm.response.json().promotion;pm.expect(p.promotionStatus).to.eql('BLOCK');pm.expect(p.blockers).to.include('test_syn_production_forbidden');});"
            ]
          }
        }
      ]
    },
