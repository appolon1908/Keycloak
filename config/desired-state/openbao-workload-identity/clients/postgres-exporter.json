{
  "clientId": "postgres-exporter",
  "name": "Codestra service identity: postgres-exporter",
  "description": "Monitoring machine identity. Reads the monitoring-only PostgreSQL role credential for the Postgres exporter. Staging via the OpenBao workload reconciler; production needs managed-client review.",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": false,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": true,
  "authorizationServicesEnabled": false,
  "frontchannelLogout": false,
  "fullScopeAllowed": false,
  "redirectUris": [],
  "webOrigins": [],
  "defaultClientScopes": [
    "basic"
  ],
  "optionalClientScopes": [
    "openbao.workload"
  ],
  "attributes": {
    "access.token.lifespan": "300",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false"
  },
  "protocolMappers": []
}
