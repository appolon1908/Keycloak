{
  "clientId": "grafana-runtime",
  "name": "Codestra service identity: grafana-runtime",
  "description": "Monitoring machine identity. Reads Grafana datasource credentials, the Middleware observability token and the Grafana OIDC secret; reads Middleware operational views. Staging via the OpenBao workload reconciler; production needs managed-client review.",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": false,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": true,
  "authorizationServicesEnabled": false,
  "frontchannelLogout": false,
  "fullScopeAllowed": false,
  "redirectUris": [],
  "webOrigins": [],
  "defaultClientScopes": [
    "basic"
  ],
  "optionalClientScopes": [
    "openbao.workload"
  ],
  "attributes": {
    "access.token.lifespan": "300",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false"
  },
  "protocolMappers": [
    {
      "name": "audience-middleware-api",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.custom.audience": "middleware-api",
        "id.token.claim": "false",
        "access.token.claim": "true"
      }
    },
    {
      "name": "reviewed-service-scopes",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "scope",
        "claim.value": "platform.services.read platform.sync.read observability.health.read observability.integrations.read observability.secrets.health.read observability.alerts.read",
        "jsonType.label": "String",
        "id.token.claim": "false",
        "access.token.claim": "true",
        "userinfo.token.claim": "false",
        "access.tokenResponse.claim": "false"
      }
    }
  ]
}
