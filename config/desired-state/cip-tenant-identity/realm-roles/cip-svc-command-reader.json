{
  "name": "cip-svc-command-reader",
  "description": "CIP dedicated single-tenant CIP service account role: obtains platform.command.read for its own tenant only. Non-composite, never default, not in the access token; prepared only.",
  "composite": false,
  "clientRole": false,
  "attributes": {
    "codestra.role.family": [
      "cip-product"
    ],
    "codestra.actor.kind": [
      "service"
    ],
    "codestra.grants.scopes": [
      "platform.command.read"
    ],
    "codestra.tenant.bound": [
      "true"
    ],
    "codestra.mfa.required": [
      "false"
    ],
    "codestra.default_role": [
      "false"
    ],
    "codestra.cross_family_grant": [
      "false"
    ],
    "codestra.activation": [
      "PREPARED_DISABLED"
    ]
  }
}
